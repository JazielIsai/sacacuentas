---
import { getEntry, render } from 'astro:content';
import Calculadora from '@/layouts/Calculadora.astro';
import CalcSeparacion from '@/components/calculadoras/CalcSeparacion';

const articulo = await getEntry('articulos', 'liquidacion');
if (!articulo) throw new Error('Falta src/content/articulos/liquidacion.mdx');
const { Content } = await render(articulo);
---

<Calculadora articulo={articulo}>
  <CalcSeparacion client:load modo="liquidacion" />
  <Content slot="articulo" />
</Calculadora>
