---
import Base from '@/layouts/Base.astro';
import AvisoLegal from '@/components/AvisoLegal.astro';
import { CALCULADORAS, SITIO } from '@/data/sitio';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITIO.nombre,
    url: Astro.site?.href,
    inLanguage: 'es-MX',
    description: SITIO.descripcion,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITIO.nombre,
    url: Astro.site?.href,
    logo: new URL('/favicon.svg', Astro.site).href,
  },
];
---

<Base title={`${SITIO.nombre}: ${SITIO.lema}`} description={SITIO.descripcion} jsonLd={jsonLd}>
  <section class="bg-gradient-to-b from-marca-50 to-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-marca-700">Gratis · Sin registro · Ley vigente</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Saca cuentas claras con tu dinero
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-700 text-pretty">
        Calculadoras laborales y financieras para México, con el resultado al instante y el paso a paso de cómo se calculó, para
        que sepas exactamente qué te toca y por qué.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4" aria-labelledby="calcs">
    <h2 id="calcs" class="sr-only">Calculadoras</h2>
    <ul class="-mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CALCULADORAS.map((c) => (
        <li>
          <a href={`/${c.slug}/`} class="tarjeta group flex h-full flex-col p-6 transition hover:-translate-y-0.5 hover:border-marca-200 hover:shadow-md">
            <span class="text-3xl" aria-hidden="true">{c.emoji}</span>
            <span class="mt-3 text-lg font-bold text-slate-900 group-hover:text-marca-700">{c.nombre}</span>
            <span class="mt-1 text-sm text-slate-600">{c.resumen}</span>
            <span class="mt-4 text-sm font-semibold text-marca-700">Calcular →</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-14 grid gap-8 sm:grid-cols-3">
      <div>
        <p class="font-bold">Explicado paso a paso</p>
        <p class="mt-1 text-sm text-slate-600">Cada resultado muestra la fórmula, los números y el artículo de la ley que la respalda.</p>
      </div>
      <div>
        <p class="font-bold">Con la ley vigente</p>
        <p class="mt-1 text-sm text-slate-600">Vacaciones dignas, salario mínimo, UMA y tablas de ISR del año, con su fuente oficial.</p>
      </div>
      <div>
        <p class="font-bold">Privado</p>
        <p class="mt-1 text-sm text-slate-600">Los cálculos se hacen en tu navegador. Tus datos no se envían a ningún servidor.</p>
      </div>
    </div>

    <AvisoLegal class="mt-12" />
  </section>
</Base>
