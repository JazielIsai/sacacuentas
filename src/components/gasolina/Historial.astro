---
/** Gráfica SVG del promedio diario (sin JS). Se muestra solo si hay al menos 2 días de histórico. */
import type { HistorialDia } from '@/lib/gasolina/agregados';
import { COMBUSTIBLES, NOMBRE_COMBUSTIBLE, type Combustible } from '@/lib/gasolina/tipos';

interface Props {
  dias: HistorialDia[];
  /** Extrae los promedios de la zona de cada día. */
  zona: { tipo: 'nacional' } | { tipo: 'estado'; cve: string } | { tipo: 'municipio'; cvegeo: string };
}
const { dias, zona } = Astro.props;
const serie = dias
  .map((d) => ({ fecha: d.fecha, v: zona.tipo === 'nacional' ? d.nacional : zona.tipo === 'estado' ? d.estados[zona.cve] : d.municipios[zona.cvegeo] }))
  .filter((d) => d.v);

const COLOR: Record<Combustible, string> = { regular: '#059669', premium: '#dc2626', diesel: '#334155' };
const W = 640, H = 220, P = { l: 48, r: 12, t: 12, b: 28 };
const valores = serie.flatMap((d) => COMBUSTIBLES.map((c) => d.v![c]).filter((x): x is number => x !== undefined));
const min = Math.floor(Math.min(...valores) - 0.2), max = Math.ceil(Math.max(...valores) + 0.2);
const x = (i: number) => P.l + (i * (W - P.l - P.r)) / Math.max(1, serie.length - 1);
const y = (v: number) => P.t + ((max - v) * (H - P.t - P.b)) / Math.max(0.01, max - min);
const lineas = COMBUSTIBLES.map((c) => ({
  c,
  d: serie.map((s, i) => (s.v![c] === undefined ? null : `${x(i)},${y(s.v![c]!)}`)).filter(Boolean).join(' '),
})).filter((l) => l.d);
const ticks = Array.from({ length: 5 }, (_, i) => min + ((max - min) * i) / 4);
const fmtFecha = (f: string) => new Date(`${f}T12:00:00Z`).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---

{serie.length >= 2 && (
  <figure class="tarjeta p-5">
    <figcaption class="text-sm font-semibold text-slate-700">Promedio diario ({serie.length} días)</figcaption>
    <svg viewBox={`0 0 ${W} ${H}`} class="mt-3 w-full" role="img" aria-label="Evolución del precio promedio">
      {ticks.map((t) => (
        <g>
          <line x1={P.l} x2={W - P.r} y1={y(t)} y2={y(t)} stroke="#e2e8f0" />
          <text x={P.l - 6} y={y(t) + 4} text-anchor="end" font-size="11" fill="#64748b">${t.toFixed(1)}</text>
        </g>
      ))}
      <text x={P.l} y={H - 8} font-size="11" fill="#64748b">{fmtFecha(serie[0].fecha)}</text>
      <text x={W - P.r} y={H - 8} font-size="11" fill="#64748b" text-anchor="end">{fmtFecha(serie.at(-1)!.fecha)}</text>
      {lineas.map((l) => <polyline points={l.d} fill="none" stroke={COLOR[l.c]} stroke-width="2.5" stroke-linejoin="round" />)}
    </svg>
    <p class="mt-2 flex flex-wrap gap-4 text-xs text-slate-600">
      {lineas.map((l) => <span class="inline-flex items-center gap-1.5"><span class="h-0.5 w-4" style={`background:${COLOR[l.c]}`} />{NOMBRE_COMBUSTIBLE[l.c]}</span>)}
    </p>
  </figure>
)}
