---
import { CALCULADORAS } from '@/data/sitio';
const actual = Astro.url.pathname.replace(/\/$/, '');
---

<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-tinta" aria-label="SacaCuentas, inicio">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-marca-600 text-white" aria-hidden="true">$</span>
      Saca<span class="-ml-2 text-marca-700">Cuentas</span>
    </a>

    <nav aria-label="Calculadoras" class="hidden xl:block">
      <ul class="flex gap-0.5 text-sm font-medium">
        {CALCULADORAS.map((c) => (
          <li>
            <a
              href={`/${c.slug}`}
              class:list={[
                'rounded-md px-3 py-2 transition-colors hover:bg-marca-50 hover:text-marca-800',
                actual === `/${c.slug}` || actual.startsWith(`/${c.slug}/`) ? 'bg-marca-50 text-marca-800' : 'text-slate-600',
              ]}
              aria-current={actual === `/${c.slug}` ? 'page' : undefined}
            >
              {c.nombre}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="relative xl:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
        Calculadoras
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
        {CALCULADORAS.map((c) => (
          <li>
            <a href={`/${c.slug}`} class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-700 hover:bg-marca-50">
              <span aria-hidden="true">{c.emoji}</span>{c.nombre}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>
