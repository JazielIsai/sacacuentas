---
import { SITIO } from '@/data/sitio';

interface Props {
  title: string;
  description: string;
  /** Objetos JSON-LD adicionales. */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, jsonLd = [], ogImage = '/og.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
// Sólo añadimos la marca si cabe en ~60 caracteres (lo que Google suele mostrar).
const fullTitle = title.includes(SITIO.nombre) || title.length > 48 ? title : `${title} | ${SITIO.nombre}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITIO.nombre} />
<meta property="og:locale" content={SITIO.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
