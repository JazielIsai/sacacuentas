---
interface Props { faq: { pregunta: string; respuesta: string }[] }
const { faq } = Astro.props;
---

{faq.length > 0 && (
  <section aria-labelledby="faq-titulo" class="mt-12">
    <h2 id="faq-titulo" class="text-2xl font-bold tracking-tight">Preguntas frecuentes</h2>
    <div class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
      {faq.map((f) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
            <h3 class="text-base">{f.pregunta}</h3>
            <span class="mt-0.5 text-marca-700 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-slate-700 leading-relaxed">{f.respuesta}</p>
        </details>
      ))}
    </div>
  </section>
)}
