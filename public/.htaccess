# SacaCuentas — configuración para Apache (Hostinger).
# El HTTPS se fuerza desde hPanel (Seguridad → SSL → "Forzar HTTPS").

Options -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /aguinaldo/ → /aguinaldo (URLs canónicas sin barra final)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [L,R=301]

  # /aguinaldo → sirve /aguinaldo/index.html sin redirigir
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_headers.c>
  # Archivos con hash en el nombre: caché de un año
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML y datos: se actualizan a diario
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "public, max-age=1800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
