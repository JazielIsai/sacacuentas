# SacaCuentas — configuración para Apache y LiteSpeed (Hostinger).
# El HTTPS se fuerza desde hPanel (Seguridad → SSL → "Forzar HTTPS").

Options -Indexes
# Las carpetas redirigen solas de /aguinaldo a /aguinaldo/ (URL canónica).
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloquear archivos ocultos (.git, .env…), salvo .well-known (certificado SSL)
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

  # www → sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_headers.c>
  # Archivos con hash en el nombre: caché de un año
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML y datos: se actualizan a diario
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "public, max-age=1800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
